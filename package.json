{
  "name": "diogo-studio",
  "version": "1.12.2",
  "private": true,
  "type": "module",
  "license": "UNLICENSED",
  "packageManager": "pnpm@11.7.0",
  "engines": {
    "node": ">=24.0.0",
    "pnpm": ">=11.0.0"
  },
  "scripts": {
    "prebuild": "pnpm agent:index:check",
    "dev": "next dev",
    "build": "next build",
    "postbuild": "pnpm prerender:check",
    "prerender:check": "tsx scripts/check-prerender.ts",
    "start": "next start",
    "agent:index": "tsx scripts/build-agent-index.ts",
    "agent:index:check": "tsx scripts/build-agent-index.ts --check",
    "analyze": "ANALYZE=true next build",
    "lint": "eslint --max-warnings 11",
    "lint:fix": "eslint --fix",
    "typecheck": "tsc --noEmit",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "e2e": "playwright test",
    "e2e:ui": "playwright test --ui",
    "e2e:ci": "pnpm build && CI=1 playwright test",
    "e2e:runner": "bash scripts/ci-local.sh",
    "e2e:install": "playwright install --with-deps",
    "knip": "knip",
    "size": "size-limit",
    "size:why": "size-limit --why",
    "validate": "pnpm lint && pnpm typecheck && pnpm format:check && pnpm test:coverage && pnpm knip",
    "prepare": "husky"
  },
  "dependencies": {
    "@ai-sdk/openai": "^4.0.36",
    "@radix-ui/react-dialog": "^1.1.23",
    "@radix-ui/react-slot": "^1.3.3",
    "@radix-ui/react-visually-hidden": "^1.2.11",
    "@react-three/drei": "^10.7.8",
    "@react-three/fiber": "^9.7.0",
    "@react-three/postprocessing": "^3.0.4",
    "@sentry/nextjs": "^10.69.0",
    "@t3-oss/env-nextjs": "^0.13.11",
    "@upstash/ratelimit": "^2.0.8",
    "@upstash/redis": "^1.38.2",
    "@vercel/analytics": "^2.0.1",
    "@vercel/speed-insights": "^2.0.0",
    "ai": "^7.0.58",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "lucide-react": "^1.30.0",
    "next": "16.3.0",
    "next-themes": "^0.4.6",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "server-only": "^0.0.1",
    "sharp": "^0.35.3",
    "tailwind-merge": "^3.6.0",
    "three": "^0.185.1",
    "web-vitals": "^6.1.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.11.3",
    "@commitlint/cli": "^21.2.1",
    "@commitlint/config-conventional": "^21.2.0",
    "@commitlint/types": "^21.2.0",
    "@next/bundle-analyzer": "^16.3.0",
    "@playwright/test": "^1.62.1",
    "@react-three/test-renderer": "^9.1.1",
    "@size-limit/file": "^13.0.3",
    "@tailwindcss/postcss": "^4",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "^7.0.0",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.3",
    "@types/node": "^26",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@types/three": "^0.185.4",
    "@vitejs/plugin-react": "^6.0.5",
    "@vitest/coverage-v8": "^4.1.10",
    "babel-plugin-react-compiler": "^1.0.0",
    "eslint": "^9",
    "eslint-config-next": "16.3.0",
    "eslint-config-prettier": "^10.1.8",
    "husky": "^9.1.7",
    "jiti": "^2.7.0",
    "jsdom": "^30.0.1",
    "knip": "^6.32.0",
    "lint-staged": "^17.3.0",
    "prettier": "^3.9.6",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "schema-dts": "^2.0.0",
    "size-limit": "^13.0.3",
    "tailwindcss": "^4",
    "tsx": "^4.23.11",
    "tw-animate-css": "^1.4.0",
    "typescript": "^6",
    "vitest": "^4.1.10"
  }
}
