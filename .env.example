# Public URL of the app (absolute URLs, sitemap, JSON-LD).
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# --- Sentry ---
NEXT_PUBLIC_SENTRY_DSN="https://examplePublicKey@o0.ingest.sentry.io/0"
SENTRY_DSN="https://examplePublicKey@o0.ingest.sentry.io/0"

# Sampling rates (0.0 - 1.0).
NEXT_PUBLIC_SENTRY_TRACES_SAMPLE_RATE="0.1"
SENTRY_TRACES_SAMPLE_RATE="0.1"

SENTRY_AUTH_TOKEN="sntrys_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx"
SENTRY_ORG="your-sentry-org"
SENTRY_PROJECT="your-sentry-project"

# --- OpenAI ---
OPENAI_API_KEY="sk-proj-..."

# --- Upstash (rate limiter) ---
UPSTASH_REDIS_REST_URL="https://example-12345.upstash.io"
UPSTASH_REDIS_REST_TOKEN="AX_AAIjxxxxxxxxxxxxxxxxxxxxxxxx"
